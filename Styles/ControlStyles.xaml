<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TopBarButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppTransparentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="FlatIconButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Background" Value="{ThemeResource AppTransparentBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppTransparentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="RegexActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinWidth" Value="110"/>
    </Style>

    <Style x:Key="TitleBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppTitleBarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppTitleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="CommandBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCommandBarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="StatusBarBorderStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Background" Value="{ThemeResource AppCommandBarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="RegexPanelBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="430"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,14,14,0"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Background" Value="{ThemeResource AppRegexPanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="RegexInfoBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource AppRegexInfoBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppPanelInnerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="TitleDocumentTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TitleSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RegexPanelTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextMutedBrush}"/>
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CounterTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RegexTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource AppTextBoxBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource AppTextBoxForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppTextBoxBorderBrush}"/>

        
    </Style>
    <Style x:Key="RegexErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppRegexErrorTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
</ResourceDictionary>