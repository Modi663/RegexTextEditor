<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="Transparent"/>
			<SolidColorBrush x:Key="AppTitleBarBackgroundBrush" Color="#33202020"/>
			<SolidColorBrush x:Key="AppCommandBarBackgroundBrush" Color="#773A3A3A"/>
            <SolidColorBrush x:Key="AppEditorBackgroundBrush" Color="#1F1F1F"/>

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="AppTextEditorBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#AFAFAF"/>
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="#CFCFCF"/>

            <SolidColorBrush x:Key="AppTitleBorderBrush" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#20FFFFFF"/>
            <SolidColorBrush x:Key="AppPanelBorderBrush" Color="#3B3B3B"/>
            <SolidColorBrush x:Key="AppPanelInnerBorderBrush" Color="#383838"/>

            <SolidColorBrush x:Key="AppRegexPanelBackgroundBrush" Color="#E62B2B2B"/>
            <SolidColorBrush x:Key="AppRegexInfoBackgroundBrush" Color="#88242424"/>

            <SolidColorBrush x:Key="AppTransparentBrush" Color="Transparent"/>

			<SolidColorBrush x:Key="AppTextBoxBackgroundBrush" Color="#262626"/>
			<SolidColorBrush x:Key="AppTextBoxForegroundBrush" Color="#F3F3F3"/>
			<SolidColorBrush x:Key="AppTextBoxBorderBrush" Color="#484848"/>

			<SolidColorBrush x:Key="AppRegexErrorBorderBrush" Color="#E06C75"/>
			<SolidColorBrush x:Key="AppRegexErrorTextBrush" Color="#FFB4AB"/>

			<SolidColorBrush x:Key="AppSelectionHighlightBrush" Color="#6680A8FF"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
			<SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="Transparent"/>
			<SolidColorBrush x:Key="AppTitleBarBackgroundBrush" Color="Transparent"/>
			<SolidColorBrush x:Key="AppCommandBarBackgroundBrush" Color="#66FFFFFF"/>
            <SolidColorBrush x:Key="AppEditorBackgroundBrush" Color="#FFFFFF"/>

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="AppTextEditorBrush" Color="#111111"/>
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#606060"/>
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="#505050"/>

            <SolidColorBrush x:Key="AppTitleBorderBrush" Color="#22000000"/>
            <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#18000000"/>
            <SolidColorBrush x:Key="AppPanelBorderBrush" Color="#26000000"/>
            <SolidColorBrush x:Key="AppPanelInnerBorderBrush" Color="#22000000"/>

            <SolidColorBrush x:Key="AppRegexPanelBackgroundBrush" Color="#F2FFFFFF"/>
            <SolidColorBrush x:Key="AppRegexInfoBackgroundBrush" Color="#0F000000"/>

            <SolidColorBrush x:Key="AppTransparentBrush" Color="Transparent"/>

			<SolidColorBrush x:Key="AppTextBoxBackgroundBrush" Color="#FFFFFF"/>
			<SolidColorBrush x:Key="AppTextBoxForegroundBrush" Color="#1F1F1F"/>
			<SolidColorBrush x:Key="AppTextBoxBorderBrush" Color="#33000000"/>

			<SolidColorBrush x:Key="AppRegexErrorBorderBrush" Color="#B3261E"/>
			<SolidColorBrush x:Key="AppRegexErrorTextBrush" Color="#B3261E"/>

			<SolidColorBrush x:Key="AppSelectionHighlightBrush" Color="#6680A8FF"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>