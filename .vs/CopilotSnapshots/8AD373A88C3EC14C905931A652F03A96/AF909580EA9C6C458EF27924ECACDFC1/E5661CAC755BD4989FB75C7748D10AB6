<Window
    x:Class="RegexTextEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RegexTextEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Regex Text Editor">

    <Grid Background="#1E1E1E">
        <Grid.Resources>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="MenuButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Верхняя синяя шапка -->
        <Grid Grid.Row="0" Background="#0B1838">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Spacing="8">
                <SymbolIcon Symbol="Document" Foreground="White"/>
                <TextBlock Text="Regex Text Editor"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Меню -->
        <Grid Grid.Row="1" Background="#18213D">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="6,0,0,0">
                <Button Style="{StaticResource MenuButtonStyle}"
                        Content="Файл"
                        Click="FileMenuButton_Click"/>

                <Button Style="{StaticResource MenuButtonStyle}"
                        Content="Изменить"
                        Click="EditMenuButton_Click"/>

                <Button Style="{StaticResource MenuButtonStyle}"
                        Content="Просмотр"
                        Click="ViewMenuButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Панель инструментов -->
        <Grid Grid.Row="2" Background="#1B1B1B" Padding="8,0">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="2">

                    <Button x:Name="NewButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="NewButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Page"/>
                            <TextBlock Text="Новый"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OpenButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="OpenFile"/>
                            <TextBlock Text="Открыть"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Save"/>
                            <TextBlock Text="Сохранить"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="#404040" Margin="6,0"/>

                    <Button x:Name="RegexPanelButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="RegexPanelButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Find"/>
                            <TextBlock Text="Regex"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PrevButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="PrevButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Up"/>
                            <TextBlock Text="Назад"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NextButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="NextButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Down"/>
                            <TextBlock Text="Далее"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReplaceCurrentButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="ReplaceCurrentButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Switch"/>
                            <TextBlock Text="Заменить"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReplaceAllButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="ReplaceAllButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Refresh"/>
                            <TextBlock Text="Заменить всё"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Область редактора -->
        <Grid Grid.Row="3" Background="#1E1E1E">
            <RichEditBox x:Name="EditorBox"
                         Margin="10,8,10,8"
                         Background="#1E1E1E"
                         Foreground="#F3F3F3"
                         BorderThickness="0"
                         FontSize="18"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"/>

            <!-- Всплывающая regex-панель -->
            <Border x:Name="RegexPanel"
                    Width="360"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Padding="14"
                    Background="#252526"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">

                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Поиск и замена (Regex)"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Button Grid.Column="1"
                                Padding="6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="CloseRegexPanelButton_Click">
                            <SymbolIcon Symbol="Cancel" Foreground="White"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Шаблон"
                               Foreground="#CFCFCF"/>
                    <TextBox x:Name="PatternTextBox"
                             PlaceholderText="Например: [A-Za-z]+1"/>

                    <TextBlock Text="Замена"
                               Foreground="#CFCFCF"/>
                    <TextBox x:Name="ReplacementTextBox"
                             PlaceholderText="Например: $0_NEW"/>

                    <TextBlock Text="Поддерживаются группы: $1, $2 и т.д."
                               Foreground="#9FA8C3"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FindButton"
                                Content="Найти"
                                Click="FindButton_Click"/>

                        <Button Content="Закрыть"
                                Click="CloseRegexPanelButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="MatchesCountTextBlock"
                               Text="Найдено: 0"
                               Foreground="White"/>

                    <TextBlock x:Name="CurrentMatchTextBlock"
                               Text="Текущее: 0/0"
                               Foreground="White"/>

                    <TextBlock x:Name="ReplacedCountTextBlock"
                               Text="Заменено: 0"
                               Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Строка состояния -->
        <Grid Grid.Row="4" Background="#18213D" Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LinesCountTextBlock"
                       Grid.Column="0"
                       Text="Строк: 0"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="CharsCountTextBlock"
                       Grid.Column="1"
                       Margin="14,0,0,0"
                       Text="Символов: 0"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Margin="14,0,0,0"
                       Text="Regex режим"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="3"
                       Text="Готово"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>