<Window
    x:Class="RegexTextEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RegexTextEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Regex Text Editor">

    <Grid Background="Transparent"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SaveAsKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="FindKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F3" Invoked="NextKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="PrevKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F1" Invoked="HelpKeyboardAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <Style x:Key="TopBarButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#F3F3F3"/>
            </Style>

            <Style x:Key="FlatIconButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#F3F3F3"/>
            </Style>

            <Style x:Key="RegexActionButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="MinWidth" Value="110"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0"
                x:Name="TitleBarRoot"
                Background="Transparent"
                BorderBrush="#24FFFFFF"
                BorderThickness="0,0,0,1">
            <Grid x:Name="AppTitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftInsetColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="RightInsetColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1"
                      x:Name="TitleBarDragRegion"
                      Padding="12,0,12,0"
                      VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Image Width="16"
                               Height="16"
                               Source="ms-appx:///Assets/StoreLogo.png"/>

                        <TextBlock x:Name="DocumentTitleTextBlock"
                                   Text="Без имени"
                                   Foreground="#F3F3F3"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="—"
                                   Foreground="#AFAFAF"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Regex Text Editor"
                                   Foreground="#AFAFAF"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Command bar -->
        <Border Grid.Row="1"
                Background="Transparent"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,0,0,1">
            <Grid Padding="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <Button Style="{StaticResource TopBarButtonStyle}"
                            Content="Файл">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Новый" Click="MenuNew_Click"/>
                                <MenuFlyoutItem Text="Открыть" Click="MenuOpen_Click"/>
                                <MenuFlyoutItem Text="Сохранить" Click="MenuSave_Click"/>
                                <MenuFlyoutItem Text="Сохранить как" Click="MenuSaveAs_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Выход" Click="MenuExit_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Style="{StaticResource TopBarButtonStyle}"
                            Content="Изменить">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Найти / Regex" Click="MenuFind_Click"/>
                                <MenuFlyoutItem Text="Следующее совпадение" Click="MenuNextMatch_Click"/>
                                <MenuFlyoutItem Text="Предыдущее совпадение" Click="MenuPrevMatch_Click"/>
                                <MenuFlyoutItem Text="Заменить всё" Click="MenuReplaceAll_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Очистить документ" Click="MenuClearDocument_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Style="{StaticResource TopBarButtonStyle}"
                            Content="Просмотр">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <ToggleMenuFlyoutItem x:Name="ToggleStatusBarMenuItem"
                                                      Text="Строка состояния"
                                                      IsChecked="True"
                                                      Click="ToggleStatusBarMenuItem_Click"/>

                                <ToggleMenuFlyoutItem x:Name="ToggleWordWrapMenuItem"
                                                      Text="Перенос строк"
                                                      IsChecked="False"
                                                      Click="ToggleWordWrapMenuItem_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Style="{StaticResource TopBarButtonStyle}"
                            Content="Справка">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="О программе" Click="MenuAbout_Click"/>
                                <MenuFlyoutItem Text="Горячие клавиши" Click="MenuShortcuts_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="RegexPanelButton"
                        Style="{StaticResource FlatIconButtonStyle}"
                        Click="RegexPanelButton_Click"
                        ToolTipService.ToolTip="Regex поиск и замена">
                    <SymbolIcon Symbol="Find"/>
                </Button>
            </Grid>
        </Border>

        <!-- Editor -->
        <Grid Grid.Row="2" Background="#1F1F1F">
            <Grid.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="#1F1F1F"/>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1F1F1F"/>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F1F1F"/>

                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>

                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </Grid.Resources>

            <RichEditBox x:Name="EditorBox"
                         Margin="0"
                         Padding="12,10,12,10"
                         Background="#1F1F1F"
                         Foreground="#F5F5F5"
                         BorderThickness="0"
                         CornerRadius="0"
                         FontSize="18"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         UseSystemFocusVisuals="False"
                         FocusVisualPrimaryThickness="0"
                         FocusVisualSecondaryThickness="0"
                         SelectionHighlightColor="#6680A8FF"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         TextChanged="EditorBox_TextChanged"/>

            <!-- Regex panel -->
            <Border x:Name="RegexPanel"
                    Width="430"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,14,0"
                    Padding="14"
                    Background="#CC2B2B2B"
                    BorderBrush="#3B3B3B"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Поиск и замена по регулярным выражениям"
                                   Foreground="#F3F3F3"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource FlatIconButtonStyle}"
                                Click="CloseRegexPanelButton_Click">
                            <SymbolIcon Symbol="Cancel"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Шаблон" Foreground="#CFCFCF"/>
                        <TextBox x:Name="PatternTextBox"
                                 PlaceholderText="Например: [A-Za-z]+1"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Замена" Foreground="#CFCFCF"/>
                        <TextBox x:Name="ReplacementTextBox"
                                 PlaceholderText="Например: $0_NEW"/>
                    </StackPanel>

                    <TextBlock Text="Поддерживаются группы захвата: $1, $2 и т.д."
                               Foreground="#AFAFAF"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Vertical" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="FindButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Найти"
                                    Click="FindButton_Click"/>

                            <Button x:Name="PrevButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Назад"
                                    Click="PrevButton_Click"/>

                            <Button x:Name="NextButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Далее"
                                    Click="NextButton_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ReplaceCurrentButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Заменить"
                                    Click="ReplaceCurrentButton_Click"/>

                            <Button x:Name="ReplaceAllButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Заменить всё"
                                    Click="ReplaceAllButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Padding="10"
                            CornerRadius="8"
                            Background="#88242424"
                            BorderBrush="#383838"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="MatchesCountTextBlock"
                                       Text="Найдено: 0"
                                       Foreground="#F3F3F3"/>

                            <TextBlock x:Name="CurrentMatchTextBlock"
                                       Text="Текущее: 0/0"
                                       Foreground="#F3F3F3"/>

                            <TextBlock x:Name="ReplacedCountTextBlock"
                                       Text="Заменено: 0"
                                       Foreground="#F3F3F3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusBarBorder"
                Grid.Row="3"
                MinHeight="30"
                Background="Transparent"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,1,0,0">
            <Grid Padding="10,4,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LinesCountTextBlock"
                           Grid.Column="0"
                           Text="Строк: 1"
                           Foreground="#F3F3F3"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="CharsCountTextBlock"
                           Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Символов: 0"
                           Foreground="#F3F3F3"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="2"
                           Text="Готово"
                           Foreground="#F3F3F3"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>