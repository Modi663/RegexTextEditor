<Window
    x:Class="RegexTextEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RegexTextEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Regex Text Editor">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppWindowBackgroundBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SaveAsKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="FindKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F3" Invoked="NextKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="PrevKeyboardAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F1" Invoked="HelpKeyboardAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                x:Name="TitleBarRoot"
                Style="{StaticResource TitleBarBorderStyle}">
            <Grid x:Name="AppTitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftInsetColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="RightInsetColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1"
                      x:Name="TitleBarDragRegion"
                      Padding="12,0,12,0"
                      VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Image Width="16"
                               Height="16"
                               Source="ms-appx:///Assets/StoreLogo.png"/>

                        <TextBlock x:Name="DocumentTitleTextBlock"
                                   Text="{Binding DocumentTitle}"
                                   Style="{StaticResource TitleDocumentTextStyle}"/>

                        <TextBlock Text="—"
                                   Style="{StaticResource TitleSecondaryTextStyle}"/>

                        <TextBlock Text="Regex Text Editor"
                                   Style="{StaticResource TitleSecondaryTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CommandBarBorderStyle}">
            <Grid Padding="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <Button Style="{StaticResource TopBarButtonStyle}"
                            Content="Файл">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Новый"
                                                Command="{x:Bind ViewModel.NewCommand}"/>
                                <MenuFlyoutItem Text="Открыть"
                                                Command="{x:Bind ViewModel.OpenCommand}"/>
                                <MenuFlyoutItem Text="Сохранить"
                                                Command="{x:Bind ViewModel.SaveCommand}"/>
                                <MenuFlyoutItem Text="Сохранить как"
                                                Command="{x:Bind ViewModel.SaveAsCommand}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Выход"
                                                Command="{x:Bind ViewModel.ExitCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Style="{StaticResource TopBarButtonStyle}"
                            Content="Изменить">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Найти / Regex"
                                                Command="{x:Bind ViewModel.OpenRegexPanelCommand}"/>
                                <MenuFlyoutItem Text="Следующее совпадение"
                                                Command="{x:Bind ViewModel.NextMatchCommand}"/>
                                <MenuFlyoutItem Text="Предыдущее совпадение"
                                                Command="{x:Bind ViewModel.PreviousMatchCommand}"/>
                                <MenuFlyoutItem Text="Заменить всё"
                                                Command="{x:Bind ViewModel.ReplaceAllCommand}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Очистить документ"
                                                Command="{x:Bind ViewModel.ClearDocumentCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Style="{StaticResource TopBarButtonStyle}"
                            Content="Просмотр">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <ToggleMenuFlyoutItem x:Name="ToggleStatusBarMenuItem"
                                  Text="Строка состояния"
                                  IsChecked="True"
                                  Click="ToggleStatusBarMenuItem_Click"/>

                                <ToggleMenuFlyoutItem x:Name="ToggleWordWrapMenuItem"
                                  Text="Перенос строк"
                                  IsChecked="False"
                                  Click="ToggleWordWrapMenuItem_Click"/>

                                <MenuFlyoutSeparator/>

                                <MenuFlyoutSubItem Text="Тема">
                                    <ToggleMenuFlyoutItem Text="Системная"
                                      IsChecked="{x:Bind ViewModel.IsSystemThemeSelected, Mode=OneWay}"
                                      Command="{x:Bind ViewModel.UseSystemThemeCommand}"/>

                                    <ToggleMenuFlyoutItem Text="Светлая"
                                      IsChecked="{x:Bind ViewModel.IsLightThemeSelected, Mode=OneWay}"
                                      Command="{x:Bind ViewModel.UseLightThemeCommand}"/>

                                    <ToggleMenuFlyoutItem Text="Тёмная"
                                      IsChecked="{x:Bind ViewModel.IsDarkThemeSelected, Mode=OneWay}"
                                      Command="{x:Bind ViewModel.UseDarkThemeCommand}"/>
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Style="{StaticResource TopBarButtonStyle}"
                            Content="Справка">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="О программе"
                                                Command="{x:Bind ViewModel.ShowAboutCommand}"/>
                                <MenuFlyoutItem Text="Горячие клавиши"
                                                Command="{x:Bind ViewModel.ShowShortcutsCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="RegexPanelButton"
                        Style="{StaticResource FlatIconButtonStyle}"
                        Command="{x:Bind ViewModel.OpenRegexPanelCommand}"
                        ToolTipService.ToolTip="Regex поиск и замена">
                    <SymbolIcon Symbol="Find"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Style="{StaticResource EditorHostGridStyle}">
            <RichEditBox x:Name="EditorBox"
             Style="{StaticResource EditorRichEditBoxStyle}"
             TextChanged="EditorBox_TextChanged">

                <RichEditBox.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>

                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#1F1F1F"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1F1F1F"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F1F1F"/>

                                <SolidColorBrush x:Key="TextControlForeground" Color="#F5F5F5"/>
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F5F5F5"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F5F5F5"/>

                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            </ResourceDictionary>

                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>

                                <SolidColorBrush x:Key="TextControlForeground" Color="#111111"/>
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#111111"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#111111"/>

                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            </ResourceDictionary>

                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </RichEditBox.Resources>
            </RichEditBox>

            <Border x:Name="RegexPanel"
                    Style="{StaticResource RegexPanelBorderStyle}"
                    Visibility="Collapsed"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="RegexPanelTranslateTransform"
                        X="24"/>
                </Border.RenderTransform>
                
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Поиск и замена по регулярным выражениям"
                                   Style="{StaticResource RegexPanelTitleTextStyle}"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource FlatIconButtonStyle}"
                                Command="{x:Bind ViewModel.CloseRegexPanelCommand}">
                            <SymbolIcon Symbol="Cancel"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Шаблон"
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBox x:Name="PatternTextBox"
                                 Style="{StaticResource RegexTextBoxStyle}"
                                 Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Например: [A-Za-z]+1"/>
                        <TextBlock x:Name="RegexErrorTextBlock"
                                   Style="{StaticResource RegexErrorTextStyle}"
                                   Text="{x:Bind ViewModel.RegexErrorText, Mode=OneWay}"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Замена"
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBox x:Name="ReplacementTextBox"
                                 Style="{StaticResource RegexTextBoxStyle}"
                                 Text="{Binding Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Например: $0_NEW"/>
                    </StackPanel>

                    <TextBlock Text="Поддерживаются группы захвата: $1, $2 и т.д."
                               Style="{StaticResource HintTextStyle}"/>

                    <StackPanel Orientation="Vertical" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="FindButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Найти"
                                    Command="{x:Bind ViewModel.FindCommand}"/>

                            <Button x:Name="PrevButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Назад"
                                    Command="{x:Bind ViewModel.PreviousMatchCommand}"/>

                            <Button x:Name="NextButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Далее"
                                    Command="{x:Bind ViewModel.NextMatchCommand}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ReplaceCurrentButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Заменить"
                                    Command="{x:Bind ViewModel.ReplaceCurrentCommand}"/>

                            <Button x:Name="ReplaceAllButton"
                                    Style="{StaticResource RegexActionButtonStyle}"
                                    Content="Заменить всё"
                                    Command="{x:Bind ViewModel.ReplaceAllCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource RegexInfoBorderStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="MatchesCountTextBlock"
                                       Text="{Binding MatchesCountText}"
                                       Style="{StaticResource CounterTextStyle}"/>

                            <TextBlock x:Name="CurrentMatchTextBlock"
                                       Text="{Binding CurrentMatchText}"
                                       Style="{StaticResource CounterTextStyle}"/>

                            <TextBlock x:Name="ReplacedCountTextBlock"
                                       Text="{Binding ReplacedCountText}"
                                       Style="{StaticResource CounterTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StatusBarBorder"
                Grid.Row="3"
                Style="{StaticResource StatusBarBorderStyle}">
            <Grid Padding="10,4,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LinesCountTextBlock"
                           Grid.Column="0"
                           Text="{Binding LinesCountText}"
                           Style="{StaticResource StatusTextStyle}"/>

                <TextBlock x:Name="CharsCountTextBlock"
                           Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="{Binding CharactersCountText}"
                           Style="{StaticResource StatusTextStyle}"/>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="2"
                           Text="{Binding StatusText}"
                           HorizontalAlignment="Right"
                           Style="{StaticResource StatusTextStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>